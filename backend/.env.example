PORT=3001
CORS_ORIGIN=http://localhost:3000

# Supabase: usar solo en backend. No usar anon_key aqui.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-o-sb-secret-key
SUPABASE_CERTIFICATES_TABLE=certificates
SUPABASE_BATCHES_TABLE=certificate_batches

# Cloudflare R2
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET=certificados
R2_SIGNED_URL_EXPIRES_SECONDS=300

# Opcional si quieres definir el endpoint directo.
# R2_ENDPOINT=https://tu-account-id.r2.cloudflarestorage.com

# PDF
PDF_FORMAT=Letter
PDF_LANDSCAPE=true
